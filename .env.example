# 环境变量示例
# 复制此文件为 .env.test 或 .env.prod 并填写实际值

# Compose 项目名（用于容器名前缀）
COMPOSE_PROJECT_NAME=xictation-test

# 数据库
POSTGRES_USER=xictation
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=xictation_test
DB_PORT=5433

# 应用
APP_PORT=18001
ENVIRONMENT=test

# 会话密钥（生产环境务必修改为随机字符串）
SECRET_KEY=change-me-in-production

# DeepSeek API（可选，不填则使用默认值）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
